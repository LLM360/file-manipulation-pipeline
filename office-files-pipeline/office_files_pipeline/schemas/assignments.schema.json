{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["assignments"],
  "additionalProperties": false,
  "properties": {
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["template_id", "rationale"],
        "additionalProperties": false,
        "properties": {
          "template_id": {"type": "string"},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
